# mc-relay 配置文件示例
#
# 用法：复制本文件为 relay.conf，把里面的值改成你自己的，然后 `python3 relay.py`。
#      relay.conf 已写进 .gitignore —— 你自己的真实地址不会被提交进仓库。
#
# 取值优先级：环境变量 > relay.conf > 内置默认
#   也就是说，如果环境变量和这里的同名键都设了，以**环境变量**为准；
#   留空或用 # 注释掉整行，则回落到内置默认（MC_TARGET 没有内置默认，见下）。
#
# 格式：KEY=VALUE，一行一个；# 开头是注释；空行忽略；值两侧可以加引号（可有可无）。
# 路径：默认读 relay.py 同目录下的 relay.conf；也可以用环境变量 RELAY_CONFIG 指定别处。

# ---------------------------------------------------------------------------
# 远端目标（必填，格式 host:port）—— 你的 wss 入口
# 没有内置默认值：环境变量与 relay.conf 都没给时，启动会直接报错并以退出码 2 结束。
# ---------------------------------------------------------------------------
MC_TARGET=your-domain.example:443

# ---------------------------------------------------------------------------
# 远端协议模式：ws（默认）| tls（旧的裸 TLS 直通，仅保留回归对照）
#   MC_MODE=ws **就是 wss**：TLS 证书校验始终内置在这条路径里（先 TLS，再在其上
#   做 WebSocket 升级）。本包没有、也不需要单独的 wss 取值——别人跟你说「走 wss」，
#   你这里保持 ws 即可（真写 wss 会被判非法值，启动直接报错）。
# ---------------------------------------------------------------------------
MC_MODE=ws

# ---------------------------------------------------------------------------
# ws 模式下的 HTTP 请求路径，默认 /
# ---------------------------------------------------------------------------
MC_WS_PATH=/

# ---------------------------------------------------------------------------
# 本机监听地址，默认 127.0.0.1:25565（只监听本机回环，不对外暴露）
# ---------------------------------------------------------------------------
LISTEN_ADDR=127.0.0.1:25565

# ---------------------------------------------------------------------------
# 建连 / CONNECT / TLS / ws 握手超时（秒），默认 15
# 只作用于握手阶段；握手完成后的长会话不做读超时。
# ---------------------------------------------------------------------------
CONNECT_TIMEOUT=15

# ---------------------------------------------------------------------------
# 注意：出站代理**不在这里配**，它只从环境变量读：
#     HTTPS_PROXY=http://127.0.0.1:7890 python3 relay.py
# ---------------------------------------------------------------------------
